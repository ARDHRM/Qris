<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>QRIS Dinamis - Premium</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
        }
    </script>
    <!-- Google Fonts: Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- QRCode.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        
        /* Glassmorphism Light & Dark */
        .glass-panel-light {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(226, 232, 240, 0.8);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }
        .glass-panel-dark {
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        /* Animations */
        .scale-in {
            animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }
        @keyframes scaleIn {
            from { opacity: 0; transform: scale(0.8) translateY(20px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }

        .fade-in {
            animation: fadeIn 0.4s ease-out forwards;
        }
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* iOS Toggle Switch */
        .toggle-checkbox:checked {
            right: 0;
            border-color: #6875f5;
        }
        .toggle-checkbox:checked + .toggle-label {
            background-color: #3b82f6;
        }

        /* Checkmark Animation */
        .checkmark-wrapper {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: block;
            stroke-width: 2;
            stroke: #4ade80;
            stroke-miterlimit: 10;
            box-shadow: inset 0px 0px 0px #4ade80;
            animation: fill .4s ease-in-out .4s forwards, scale .3s ease-in-out .9s both;
        }
        .checkmark__circle {
            stroke-dasharray: 166;
            stroke-dashoffset: 166;
            stroke-width: 2;
            stroke-miterlimit: 10;
            stroke: #4ade80;
            fill: none;
            animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
        }
        .checkmark__check {
            transform-origin: 50% 50%;
            stroke-dasharray: 48;
            stroke-dashoffset: 48;
            animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
        }
        @keyframes stroke { 100% { stroke-dashoffset: 0; } }
        @keyframes scale { 0%, 100% { transform: none; } 50% { transform: scale3d(1.1, 1.1, 1); } }
        @keyframes fill { 100% { box-shadow: inset 0px 0px 0px 30px rgba(74, 222, 128, 0.1); } }
    </style>
</head>
<body id="bodyRoot" class="min-h-screen bg-slate-100 dark:bg-slate-950 flex items-center justify-center p-4 transition-colors duration-300 relative overflow-x-hidden">

    <!-- Ambient Glow Background -->
    <div class="absolute top-[-10%] left-[-10%] w-72 h-72 bg-purple-400 dark:bg-purple-600 rounded-full mix-blend-multiply filter blur-[128px] opacity-30"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-72 h-72 bg-blue-400 dark:bg-blue-600 rounded-full mix-blend-multiply filter blur-[128px] opacity-30"></div>

    <!-- Theme Switcher (Top Right) -->
    <div class="absolute top-5 right-5 z-20 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <div class="relative inline-block w-12 align-middle select-none transition duration-200 ease-in">
            <input type="checkbox" name="toggle" id="themeToggle" class="toggle-checkbox absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer border-slate-300 dark:border-slate-700 transition-all duration-300 left-0 checked:right-0 checked:left-auto"/>
            <label for="themeToggle" class="toggle-label block overflow-hidden h-6 rounded-full bg-slate-300 dark:bg-slate-700 cursor-pointer transition-colors duration-300"></label>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
    </div>

    <main id="mainPanel" class="glass-panel-light dark:glass-panel-dark w-full max-w-md p-6 sm:p-8 rounded-3xl relative z-10 fade-in transition-all duration-300">
        
        <!-- Header -->
        <div class="text-center mb-6">
            <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-purple-600 dark:from-blue-400 dark:to-purple-400">
                QRIS Dinamis
            </h1>
            <p class="text-slate-500 dark:text-slate-400 text-xs mt-1">ARIF DHARMA, DIGITAL & KREATIF</p>
        </div>

        <!-- Input Section -->
        <div id="inputSection" class="flex flex-col gap-6">
            
            <!-- Error Alert -->
            <div id="errorMessage" class="hidden bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-300 px-4 py-3 rounded-xl text-sm backdrop-blur-sm">
                <span id="errorText"></span>
            </div>

            <!-- Nominal Display Box -->
            <div class="flex flex-col gap-1.5">
                <label class="text-xs font-medium text-slate-500 dark:text-slate-400 ml-1">Total Nominal</label>
                <div class="w-full bg-slate-200/60 dark:bg-slate-900/60 border border-slate-300 dark:border-slate-800 rounded-2xl py-4 px-5 text-right shadow-inner">
                    <span id="nominalDisplay" class="text-3xl sm:text-4xl font-bold text-slate-800 dark:text-white tracking-tight">Rp 0</span>
                </div>
            </div>

            <!-- iOS Numeric Keypad -->
            <div class="grid grid-cols-3 gap-2.5">
                <button type="button" data-key="1" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-xl">1</button>
                <button type="button" data-key="2" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-xl">2</button>
                <button type="button" data-key="3" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-xl">3</button>
                
                <button type="button" data-key="4" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-xl">4</button>
                <button type="button" data-key="5" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-xl">5</button>
                <button type="button" data-key="6" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-xl">6</button>
                
                <button type="button" data-key="7" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-xl">7</button>
                <button type="button" data-key="8" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-xl">8</button>
                <button type="button" data-key="9" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-xl">9</button>
                
                <!-- Row 4: 000 swapped into position of 0 -->
                <button type="button" data-key="000" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-lg">000</button>
                <button type="button" data-key="0" class="numpad-btn bg-white/70 dark:bg-slate-800/70 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-white font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 text-xl">0</button>
                <button type="button" data-key="del" class="bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 font-semibold py-3.5 rounded-xl shadow-sm transition-all active:scale-95 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414 6.414a2 2 0 001.414.586H19a2 2 0 002-2V7a2 2 0 00-2-2h-8.172a2 2 0 00-1.414.586L3 12z" />
                    </svg>
                </button>
            </div>

            <!-- Action Buttons -->
            <div class="flex gap-3">
                <button type="button" id="clearBtn" class="w-1/3 py-4 rounded-xl font-medium border border-slate-300 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 transition-colors">
                    Reset
                </button>
                <button type="button" id="generateBtn" 
                    class="w-2/3 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-500 hover:to-purple-500 text-white font-semibold py-4 rounded-xl shadow-[0_4px_20px_rgba(59,130,246,0.3)] transition-all transform active:scale-95">
                    Buat QRIS
                </button>
            </div>
        </div>

        <!-- Result Section (Hidden by default) -->
        <div id="resultSection" class="hidden flex-col items-center">
            
            <p class="text-slate-500 dark:text-slate-400 text-sm mb-1">Total Pembayaran</p>
            <div class="text-3xl font-bold text-slate-800 dark:text-white mb-6 tracking-tight" id="displayNominal">Rp 0</div>
            
            <!-- QR Container -->
            <div class="bg-white p-5 rounded-3xl shadow-xl mb-6 relative group scale-in border border-slate-200 dark:border-none">
                <div id="qrcode"></div>
                <!-- Simpan Button (Top Right of Card) -->
                <button id="saveBtn" class="absolute top-3 right-3 bg-slate-900/80 hover:bg-black text-white p-2 rounded-xl backdrop-blur-md transition-colors shadow-lg" title="Simpan QR">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                    </svg>
                </button>
            </div>

            <!-- Action Buttons -->
            <div class="flex gap-3 w-full fade-in">
                <button id="resetBtn" class="flex-1 py-3.5 rounded-xl font-medium border border-slate-300 dark:border-slate-700 hover:bg-slate-200/50 dark:hover:bg-slate-800/50 transition-colors text-slate-600 dark:text-slate-300">
                    Batal
                </button>
                <button id="paidBtn" class="flex-1 py-3.5 rounded-xl font-medium bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-white shadow-lg shadow-emerald-500/20 transition-all transform active:scale-95">
                    Sudah Dibayar
                </button>
            </div>
        </div>

        <!-- Success Overlay -->
        <div id="successOverlay" class="absolute inset-0 z-50 glass-panel-light dark:glass-panel-dark rounded-3xl hidden flex-col items-center justify-center opacity-0 transition-opacity duration-300">
            <svg class="checkmark-wrapper" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                <circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none"/>
                <path class="checkmark__check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
            </svg>
            <p class="text-slate-800 dark:text-white mt-6 text-xl font-semibold tracking-wide fade-in" style="animation-delay: 1s;">Transaksi Berhasil</p>
        </div>

    </main>

<script>
    // ==========================================
    // STRING QRIS STATIS ANDA DI SINI
    // ==========================================
    const STATIC_QRIS = '00020101021126610014COM.GO-JEK.WWW01189360091438351492230210G8351492230303UMI51440014ID.CO.QRIS.WWW0215ID10254285662160303UMI5204899953033605802ID5925ARIF DHARMA , Digital & K6008PONOROGO61056341862070703A016304333A';

    // State Nominal
    let currentRawValue = "";

    // Referensi DOM
    const bodyRoot = document.getElementById('bodyRoot');
    const themeToggle = document.getElementById('themeToggle');
    const inputSection = document.getElementById('inputSection');
    const resultSection = document.getElementById('resultSection');
    const nominalDisplay = document.getElementById('nominalDisplay');
    const generateBtn = document.getElementById('generateBtn');
    const clearBtn = document.getElementById('clearBtn');
    const resetBtn = document.getElementById('resetBtn');
    const paidBtn = document.getElementById('paidBtn');
    const saveBtn = document.getElementById('saveBtn');
    const qrcodeDiv = document.getElementById('qrcode');
    const displayNominal = document.getElementById('displayNominal');
    const errorMessage = document.getElementById('errorMessage');
    const errorText = document.getElementById('errorText');
    const successOverlay = document.getElementById('successOverlay');
    const numpadBtns = document.querySelectorAll('.numpad-btn');

    let qrcode = null;

    // Default Light Mode Setup
    if (localStorage.getItem('theme') === 'dark') {
        bodyRoot.classList.add('dark');
        themeToggle.checked = true;
    } else {
        bodyRoot.classList.remove('dark');
        themeToggle.checked = false;
    }

    // Toggle Theme Event
    themeToggle.addEventListener('change', () => {
        if (themeToggle.checked) {
            bodyRoot.classList.add('dark');
            localStorage.setItem('theme', 'dark');
        } else {
            bodyRoot.classList.remove('dark');
            localStorage.setItem('theme', 'light');
        }
    });

    // Fungsi Format Rupiah
    function formatRupiah(angka) {
        if (!angka || angka === "") return "Rp 0";
        let numberString = angka.replace(/[^,\d]/g, "").toString();
        let split = numberString.split(",");
        let sisa = split[0].length % 3;
        let rupiah = split[0].substr(0, sisa);
        let ribuan = split[0].substr(sisa).match(/\d{3}/gi);

        if (ribuan) {
            let separator = sisa ? "." : "";
            rupiah += separator + ribuan.join(".");
        }
        rupiah = split[1] != undefined ? rupiah + "," + split[1] : rupiah;
        return "Rp " + rupiah;
    }

    // Keypad Logic
    numpadBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            hideError();
            const key = btn.getAttribute('data-key');
            
            if (key === 'del') {
                currentRawValue = currentRawValue.slice(0, -1);
            } else {
                // Cegah digit awal 0 berlebihan
                if (currentRawValue === "0" && key !== "000") {
                    currentRawValue = key;
                } else {
                    // Batasi panjang agar tidak overflow
                    if (currentRawValue.length < 10) {
                        currentRawValue += key;
                    }
                }
            }

            nominalDisplay.innerText = formatRupiah(currentRawValue);
        });
    });

    // Clear Button
    clearBtn.addEventListener('click', () => {
        currentRawValue = "";
        nominalDisplay.innerText = "Rp 0";
        hideError();
    });

    // Fungsi Kalkulasi CRC16-CCITT
    function crc16(str) {
        let crc = 0xFFFF;
        for (let c = 0; c < str.length; c++) {
            crc ^= str.charCodeAt(c) << 8;
            for (let i = 0; i < 8; i++) {
                if (crc & 0x8000) crc = (crc << 1) ^ 0x1021;
                else crc = crc << 1;
            }
        }
        return (crc & 0xFFFF).toString(16).toUpperCase().padStart(4, '0');
    }

    // Fungsi Error UI
    function showError(msg) {
        errorText.innerText = msg;
        errorMessage.classList.remove('hidden');
        errorMessage.classList.add('fade-in');
    }

    function hideError() {
        errorMessage.classList.add('hidden');
    }

    // Generate QRIS Dinamis
    generateBtn.addEventListener('click', () => {
        hideError();
        const amount = parseInt(currentRawValue);

        if (!amount || isNaN(amount) || amount <= 0) {
            showError("Silakan masukkan nominal pembayaran terlebih dahulu.");
            return;
        }

        try {
            // Ubah statis (01) menjadi dinamis (02)
            let qris = STATIC_QRIS.replace("010211", "010212");
            let nominalStr = amount.toString();
            // Buat tag 54: "54" + panjang string nominal (2 digit) + nominal
            let nominalTag = "54" + nominalStr.length.toString().padStart(2, '0') + nominalStr;
            
            // Buang CRC lama (4 karakter terakhir)
            qris = qris.slice(0, -4); 
            
            let index6304 = qris.lastIndexOf("6304");
            if (index6304 === -1) {
                showError("Format QRIS tidak valid. Tag '6304' tidak ditemukan.");
                return;
            }

            // Sisipkan tag nominal sebelum tag 6304
            let newQris = qris.substring(0, index6304) + nominalTag + qris.substring(index6304);
            // Hitung ulang CRC
            let finalCrc = crc16(newQris);
            let finalQris = newQris + finalCrc;

            // Update UI
            displayNominal.innerText = formatRupiah(amount.toString());
            qrcodeDiv.innerHTML = "";
            
            // Render QR Code baru
            qrcode = new QRCode(qrcodeDiv, {
                text: finalQris,
                width: 240,
                height: 240,
                colorDark : "#0f172a",
                colorLight : "#ffffff",
                correctLevel : QRCode.CorrectLevel.M
            });

            // Transisi UI
            inputSection.classList.add('hidden');
            resultSection.classList.remove('hidden');
            resultSection.classList.add('flex');

        } catch (e) {
            showError("Terjadi kesalahan memproses QRIS.");
            console.error(e);
        }
    });

    // Reset (Batal)
    resetBtn.addEventListener('click', resetApp);

    function resetApp() {
        resultSection.classList.add('hidden');
        resultSection.classList.remove('flex');
        inputSection.classList.remove('hidden');
        currentRawValue = "";
        nominalDisplay.innerText = "Rp 0";
        hideError();
        successOverlay.classList.add('hidden');
        successOverlay.classList.remove('flex');
        successOverlay.style.opacity = '0';
    }

    // Simpan QR sebagai Gambar
    saveBtn.addEventListener('click', () => {
        const canvas = document.querySelector('#qrcode canvas');
        if (canvas) {
            const url = canvas.toDataURL('image/png');
            const a = document.createElement('a');
            a.href = url;
            a.download = `QRIS-${currentRawValue}.png`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
    });

    // Sudah Dibayar (Tampilkan Animasi Sukses)
    paidBtn.addEventListener('click', () => {
        successOverlay.classList.remove('hidden');
        successOverlay.classList.add('flex');
        void successOverlay.offsetWidth;
        successOverlay.style.opacity = '1';

        setTimeout(() => {
            resetApp();
        }, 3000);
    });

</script>
</body>
</html>
